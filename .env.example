# Supabase — get these from `supabase status` when running locally,
# or from your hosted project's Settings > API page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — bypasses RLS. Two uses, both narrow:
#   1. scripts/ (seed, auditoria) rodados à mão por um dev;
#   2. src/lib/supabase/admin.ts, que grava evidência do learning graph
#      server-side (ver 0013_harden_privileges.sql — a escrita saiu do
#      alcance do cliente porque o aluno forjava o próprio domínio).
# Nunca use para LEITURA que renderiza tela: leitura passa pela sessão do
# usuário, onde a RLS é a fronteira.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — lido só em rotas server-side (tutor, conselheiro, insights,
# construtor). Nunca exposto ao cliente.
ANTHROPIC_API_KEY=

# Painel de demonstração em /dev — permite entrar como qualquer perfil e criar
# contas de teste com qualquer papel.
#
# ⚠️ É, por construção, a escalação de privilégio que 0013 fechou; a única
# coisa que a impede é esta variável estar ausente. Deixe VAZIA em qualquer
# ambiente com dado de aluno real. Ligue (=1) apenas em dev e na demo com
# base fake.
PAIDEIA_DEV_PANEL=
