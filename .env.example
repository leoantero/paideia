# Supabase — get these from `supabase status` when running locally,
# or from your hosted project's Settings > API page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — NEVER imported by application runtime code.
# Only used by local test/seed scripts run manually by a developer.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — read ONLY inside app/api/tutor/chat/route.ts (server-side).
# Never expose this to the client.
ANTHROPIC_API_KEY=
